# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only values
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
SYNC_SECRET=generate-a-long-random-secret
ICAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_URL=http://localhost:3000

# Local development only; never enable in production
DEMO_MODE=true
