# Browser-safe Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only values
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
SYNC_SECRET=generate-a-long-random-secret
ICAL_ENCRYPTION_KEY=base64-encoded-32-byte-key
APP_URL=http://localhost:3000

# Website-to-admin internal API. Keep these server-side in both deployments.
BOOKING_API_KEY_ID=booking-api-2026-01
BOOKING_API_HMAC_SECRET=generate-a-long-random-secret
# Optional overlap during a deliberate key rotation only.
BOOKING_API_PREVIOUS_KEY_ID=
BOOKING_API_PREVIOUS_HMAC_SECRET=

# Razorpay Test Mode only until a separately approved production rollout.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# Zoho ZeptoMail transactional sender.
ZEPTOMAIL_TOKEN=replace-me
ZEPTOMAIL_SENDER_ADDRESS=bookings@example.com
ZEPTOMAIL_SENDER_NAME=Noir Haus
# Optional; defaults to hello@noirhaus.in.
GUEST_SUPPORT_EMAIL=hello@noirhaus.in
ADMIN_NOTIFICATION_EMAIL=admin@example.com

# Dedicated one-minute booking worker secret and safe rollout gates.
BOOKING_CRON_SECRET=generate-a-different-long-random-secret
INVENTORY_LEDGER_MODE=shadow
PUBLIC_AVAILABILITY_ENABLED=false
PUBLIC_BOOKING_ENABLED=false

# Local development only; never enable in production
DEMO_MODE=true
